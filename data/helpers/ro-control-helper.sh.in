#!/bin/sh

set -eu
set -f

run_allowed_command() {
  if [ "$#" -lt 1 ]; then
    echo "ro-control-helper: missing command" >&2
    exit 64
  fi

  command_name="$1"
  shift

  # Accept only the locale wrapper emitted by ro-Control, then validate the
  # nested executable through this same allowlist. Do not grant generic env.
  if [ "${command_name}" = "env" ]; then
    if [ "$#" -lt 2 ] || [ "$1" != "LANG=C" ]; then
      echo "ro-control-helper: command not allowed: env" >&2
      exit 64
    fi
    shift
    LANG=C run_allowed_command "$@"
    return "$?"
  fi

  case "$command_name" in
    dnf|/usr/bin/dnf)
      resolved_path="$(command -v dnf 2>/dev/null || true)"
      ;;
    akmods|/usr/sbin/akmods|/usr/bin/akmods)
      resolved_path="$(command -v akmods 2>/dev/null || true)"
      ;;
    dracut|/usr/bin/dracut)
      resolved_path="$(command -v dracut 2>/dev/null || true)"
      ;;
    grubby|/usr/sbin/grubby|/usr/bin/grubby)
      resolved_path="$(command -v grubby 2>/dev/null || true)"
      ;;
    nvidia-smi|/usr/bin/nvidia-smi)
      resolved_path="$(command -v nvidia-smi 2>/dev/null || true)"
      ;;
    *)
      echo "ro-control-helper: command not allowed: ${command_name}" >&2
      exit 64
      ;;
  esac

  if [ -z "${resolved_path}" ] || [ ! -x "${resolved_path}" ]; then
    echo "ro-control-helper: command not found: ${command_name}" >&2
    exit 127
  fi

  child_pid=""
  terminate_child() {
    if [ -n "${child_pid}" ]; then
      kill -TERM "${child_pid}" 2>/dev/null || true
      wait "${child_pid}" 2>/dev/null || true
    fi
    exit 130
  }

  trap terminate_child INT TERM

  "${resolved_path}" "$@" &
  child_pid="$!"
  if wait "${child_pid}"; then
    status=0
  else
    status="$?"
  fi
  child_pid=""
  trap - INT TERM
  return "${status}"
}

if [ "$#" -ge 1 ] && [ "$1" = "--batch" ]; then
  tab="$(printf '\t')"

  # Each batch line is tab-separated: command<TAB>arg1<TAB>arg2...
  while IFS= read -r command_line || [ -n "${command_line}" ]; do
    [ -z "${command_line}" ] && continue

    command_name="${command_line%%"${tab}"*}"
    if [ "${command_name}" = "${command_line}" ]; then
      run_allowed_command "${command_name}"
      continue
    fi

    remaining="${command_line#*"${tab}"}"
    set --
    while :; do
      case "${remaining}" in
        *"${tab}"*)
          argument="${remaining%%"${tab}"*}"
          remaining="${remaining#*"${tab}"}"
          set -- "$@" "${argument}"
          ;;
        *)
          set -- "$@" "${remaining}"
          break
          ;;
      esac
    done

    run_allowed_command "${command_name}" "$@"
  done

  exit 0
fi

run_allowed_command "$@"
